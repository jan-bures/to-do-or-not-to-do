<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: plain http to a server on this device (an adb reverse to a throwaway server on the
  computer, see docs/android.md). Everything else stays HTTPS only, as in release, apart from the
  certificate revocation hosts explained in the main config.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">lencr.org</domain>
        <domain includeSubdomains="true">pki.goog</domain>
        <domain includeSubdomains="true">ssl.com</domain>
        <domain includeSubdomains="true">sectigo.com</domain>
        <domain includeSubdomains="true">usertrust.com</domain>
        <domain includeSubdomains="true">digicert.com</domain>
    </domain-config>
</network-security-config>
