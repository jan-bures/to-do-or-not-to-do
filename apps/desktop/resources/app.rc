// The exe's resources: the app icon (resource id 1, the one `gpui_windows` loads for the window class and the
// tray loads for its icon) and the version information Explorer and Task Manager show. The icon is generated
// from `assets/brand` (see `assets/brand/README.md`).

1 ICON "../../../assets/brand/generated/todo.ico"

#define VS_VERSION_INFO 1
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_APP 0x00000001L

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "To-do"
            VALUE "ProductName", "To-do"
            VALUE "InternalName", "todo-desktop"
            VALUE "OriginalFilename", "todo-desktop.exe"
            VALUE "FileVersion", VERSION_STRING
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
