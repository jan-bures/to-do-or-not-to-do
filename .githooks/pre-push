#!/bin/sh
# Blocks pushes whose new commits (content, paths, messages, author/committer identities) contain
# denylisted text or secrets. Reads "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
hooks="$(git rev-parse --show-toplevel)/.githooks"
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"                            # new branch: scan its whole history
  else
    range="$remote_sha..$local_sha"
  fi
  tmp="$(mktemp)"
  {
    git log --format='%an <%ae>%n%cn <%ce>%n%B' "$range"
    git log -p --no-color --format= "$range" | grep '^+' | grep -v '^+++'
    git log --name-only --format= "$range"
  } > "$tmp"
  sh "$hooks/leak-check.sh" "$tmp" "commits for $remote_ref" || status=1
  rm -f "$tmp"

  if command -v gitleaks > /dev/null 2>&1; then
    gitleaks git --no-banner --redact --log-opts="$range" . || status=1
  fi
done

[ $status -ne 0 ] && echo "pre-push: push blocked." >&2
exit $status
