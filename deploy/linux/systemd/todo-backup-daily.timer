# Installed by deploy/linux/provision.sh. Once per calendar day, like the Windows pilot. A day missed
# while the VM was off runs at the next boot.
[Unit]
Description=todo daily backup

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=15min
Persistent=true
Unit=todo-backup@daily.service

[Install]
WantedBy=timers.target
