# Installed by deploy/linux/provision.sh. The Cloudflare Tunnel connector: it only connects outbound,
# so the VM needs no inbound port. It runs as the cloudflared system user, which can read the token file
# (root:cloudflared 0640) but not change it. The token never appears on a command line, in the
# environment or in this file.
[Unit]
Description=Cloudflare Tunnel connector for todo-server
After=network-online.target todo-server.service
Wants=network-online.target
ConditionPathExists=/etc/cloudflared/todo-tunnel.token

[Service]
Type=notify
User=cloudflared
Group=cloudflared
# apt (and unattended-upgrades) keeps cloudflared current, so it never updates itself.
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token-file /etc/cloudflared/todo-tunnel.token
Restart=on-failure
RestartSec=5s
TimeoutStartSec=0

MemoryHigh=160M
MemoryMax=256M
MemorySwapMax=128M
TasksMax=128
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
# Netlink: Go lists the network interfaces.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
